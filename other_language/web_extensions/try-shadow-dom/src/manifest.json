{
	"manifest_version": 3,
	"name": "Try Shadow DOM",
	"version": "0.1.0.0",
	"permissions": [],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"]
		}
	],
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"options_ui": {
		"page": "options.html"
	}
}
