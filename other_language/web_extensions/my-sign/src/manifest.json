{
	"manifest_version": 3,
	"name": "My Sign",
	"version": "0.1.0.0",
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"]
		}
	],
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"options_ui": {
		"page": "options.html"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "my-sign@yoshikunijujo.github.io",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
