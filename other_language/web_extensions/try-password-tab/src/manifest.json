{
	"manifest_version": 3,
	"name": "Password Input Tab Experiment",
	"version": "0.1.0.0",
	"permissions": ["storage"],

	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"content_scripts": [{
		"matches": ["<all_urls>"],
		"js": ["mapArray.js", "content.js"],
		"run_at": "document_end" }],
	"browser_specific_settings": {
		"gecko": {
			"id": "try-password-tab@yoshikunijujo.github.io",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
